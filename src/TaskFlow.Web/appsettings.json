{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=taskflow.db;Cache=Shared;Foreign Keys=True"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/taskflow-.log", "rollingInterval": "Day" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "TaskFlow"
    }
  },
  "AllowedHosts": "*"
}