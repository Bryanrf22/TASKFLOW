@using Microsoft.AspNetCore.Identity
@using TaskFlow.Data
@using TaskFlow.Core.Domain.Authorization
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Projects" asp-action="Index">Proyectos</a>
        </li>
        <li class="nav-item">
            <span class="nav-link text-dark">Hola, @User.Identity!.Name!</span>
        </li>
        @if (User.IsInRole(ApplicationRoles.Admin))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Usuarios</a>
            </li>
        }
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                <button type="submit" class="nav-link btn btn-link text-dark">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        </li>
    }
</ul>