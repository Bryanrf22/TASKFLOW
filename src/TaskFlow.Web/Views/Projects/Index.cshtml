@model TaskFlow.Web.Models.Projects.ProjectsIndexViewModel
@{
    ViewData["Title"] = "Mis proyectos";
}

<h1 class="h3 mb-4">Mis proyectos</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row">
    <div class="col-lg-8">
        @if (Model.Projects.Count == 0)
        {
            <p class="text-muted">Aún no participas en ningún proyecto.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Proyecto</th>
                            <th>Clave</th>
                            <th>Tu rol</th>
                            <th>Creado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Projects)
                        {
                            <tr>
                                <td><a asp-controller="Projects" asp-action="Details" asp-route-projectId="@p.ProjectId">@p.Name</a></td>
                                <td><span class="badge text-bg-light">@p.Key</span></td>
                                <td>@p.MyRole</td>
                                <td>@p.CreatedAtUtc.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Crear proyecto</div>
            <div class="card-body">
                <partial name="_CreateProjectForm" model="Model.Create" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}